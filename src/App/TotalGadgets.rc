#include <windows.h>
#include "Resource.h"

IDR_MAINFRAME ICON "../assets/icon.ico"

1 RT_MANIFEST "TotalGadgets.manifest"

// ---------------------------------------------------------------------------
// Menu bar (utility primary window)
// ---------------------------------------------------------------------------

IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Scan...\tF5",                    IDC_SCAN
        MENUITEM SEPARATOR
        POPUP "Recent &Folders"
        BEGIN
            MENUITEM "(no recent folders)",         ID_MRU_FOLDER0, GRAYED
        END
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                           IDCANCEL
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Copy Selected\tCtrl+C",          ID_EDIT_COPY_SEL
        MENUITEM "Copy &All Filtered Rows",         ID_EDIT_COPY_ALL
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Gadgets\tCtrl+1",                ID_VIEW_GADGETS
        MENUITEM "&Log\tCtrl+2",                    ID_VIEW_LOG
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "&Open Output Folder\tCtrl+E",     ID_TOOLS_OPEN_OUTPUT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Total Gadgets\tF1",        ID_HELP_ABOUT
    END
END

// ---------------------------------------------------------------------------
// Keyboard accelerators
// ---------------------------------------------------------------------------

IDR_ACCEL ACCELERATORS
BEGIN
    VK_F5,      IDC_SCAN,             VIRTKEY, NOINVERT
    "1",        ID_VIEW_GADGETS,      VIRTKEY, CONTROL, NOINVERT
    "2",        ID_VIEW_LOG,          VIRTKEY, CONTROL, NOINVERT
    "E",        ID_TOOLS_OPEN_OUTPUT, VIRTKEY, CONTROL, NOINVERT
    "C",        ID_EDIT_COPY_SEL,     VIRTKEY, CONTROL, NOINVERT
    VK_INSERT,  ID_EDIT_COPY_SEL,     VIRTKEY, NOINVERT
    VK_F1,      ID_HELP_ABOUT,        VIRTKEY, NOINVERT
END

// ---------------------------------------------------------------------------
// Main window
// ---------------------------------------------------------------------------

IDD_MAINDLG DIALOGEX 0, 0, 470, 506
STYLE DS_SETFONT | DS_CENTER | WS_MINIMIZEBOX | WS_MAXIMIZEBOX |
      WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
MENU IDR_MAINMENU
CAPTION "Total Gadgets v2"
FONT 9, "Segoe UI"
BEGIN
    // --- Input ---
    GROUPBOX        "Input", IDC_GRP_INPUT, 8, 4, 454, 72

    RTEXT           "&Input folder:", -1, 8, 19, 40, 8
    COMBOBOX        IDC_FOLDER_COMBO, 50, 17, 373, 120,
                    CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "...", IDC_BROWSE_FOLDER, 427, 17, 28, 14

    CONTROL         "Include &subfolders", IDC_RECURSIVE, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 50, 38, 90, 10
    CONTROL         "Include &ELF binaries", IDC_ELF, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 150, 38, 100, 10

    // --- Output ---
    GROUPBOX        "Output", IDC_GRP_OUTPUT, 8, 80, 454, 54

    RTEXT           "&Output path:", -1, 8, 95, 40, 8
    EDITTEXT        IDC_OUTPUT_PATH, 50, 93, 373, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_BROWSE_OUTPUT, 427, 93, 28, 14

    RTEXT           "&Format:", -1, 8, 112, 40, 8
    COMBOBOX        IDC_FORMAT, 50, 110, 62, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL         "One file per &module", IDC_SPLIT, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 120, 111, 96, 10
    CONTROL         "Open &when done", IDC_OPEN_WHEN_DONE, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 224, 111, 96, 10

    // --- Search Options ---
    GROUPBOX        "Search Options", IDC_GRP_SEARCH, 8, 138, 270, 62

    RTEXT           "Max &len:", -1, 10, 153, 38, 8
    EDITTEXT        IDC_MAX_GADGET_LEN, 52, 151, 26, 14, ES_NUMBER | ES_CENTER
    RTEXT           "&Threads:", -1, 82, 153, 34, 8
    EDITTEXT        IDC_MAX_THREADS, 120, 151, 26, 14, ES_NUMBER | ES_CENTER
    CONTROL         "&Unique only", IDC_UNIQUE_ONLY, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 162, 152, 62, 10
    CONTROL         "&Branches", IDC_ALLOW_BRANCHES, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 162, 166, 52, 10
    RTEXT           "Ba&d bytes:", -1, 10, 169, 38, 8
    EDITTEXT        IDC_BAD_BYTES, 52, 167, 94, 14, ES_AUTOHSCROLL

    // --- Mutation ---
    GROUPBOX        "Mutation (capstone 2nd decoder)", IDC_GRP_MUTATION,
                    286, 138, 176, 62
    CONTROL         "Enable&d", IDC_ENABLE_MUTATION, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 296, 153, 50, 10
    CONTROL         "Branc&hes", IDC_MUTATE_BRANCHES, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 296, 167, 56, 10
    RTEXT           "Lookbac&k:", -1, 350, 153, 42, 8
    EDITTEXT        IDC_MAX_MUTATION_OFFSET, 396, 151, 26, 14,
                    ES_NUMBER | ES_CENTER

    // --- Scan / Cancel + progress ---
    DEFPUSHBUTTON   "Scan", IDC_SCAN, 8, 208, 88, 20
    CONTROL         "", IDC_PROGRESS, "msctls_progress32",
                    PBS_SMOOTH, 104, 210, 358, 14

    // --- Results / Log ---
    CONTROL         "", IDC_TAB, "SysTabControl32", 0, 8, 232, 454, 246

    // Gadgets pane (direct children; visibility follows the tab)
    LTEXT           "Filter:", IDC_FILTER_LBL, 16, 256, 26, 8
    EDITTEXT        IDC_FILTER, 44, 254, 150, 14, ES_AUTOHSCROLL
    COMBOBOX        IDC_MODULE_FILTER, 200, 254, 130, 200,
                    CBS_DROPDOWNLIST | WS_TABSTOP
    PUSHBUTTON      "&Copy", IDC_COPY, 336, 253, 40, 14
    RTEXT           "", IDC_RESULTS_COUNT, 380, 256, 74, 8
    CONTROL         "", IDC_LIST, "SysListView32",
                    LVS_REPORT | LVS_OWNERDATA | LVS_SHOWSELALWAYS |
                    WS_TABSTOP | WS_VSCROLL | WS_HSCROLL,
                    16, 270, 438, 196

    // Log pane (same rect as the list; hidden initially)
    EDITTEXT        IDC_LOG, 16, 270, 438, 196, ES_MULTILINE | ES_AUTOVSCROLL |
                    ES_READONLY | WS_VSCROLL

    // --- Status bar ---
    CONTROL         "", IDC_STATUSBAR, "msctls_statusbar32", SBARS_SIZEGRIP,
                    0, 492, 470, 14
END
